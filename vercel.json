{
"version": 2,
"rewrites": [
{ "source": "/api/items", "destination": "/api/items.js" },
{ "source": "/api/login", "destination": "/api/login.js" },
{ "source": "/api/logout", "destination": "/api/logout.js" },
{ "source": "/api/me", "destination": "/api/me.js" },
{ "source": "/api/register", "destination": "/api/register.js" }
],
"headers": [
{
"source": "/(.*)",
"headers": [
{ "key": "X-Content-Type-Options", "value": "nosniff" },
{ "key": "X-Frame-Options", "value": "DENY" }
]
}
]
}
